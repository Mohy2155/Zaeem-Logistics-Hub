{
  "name": "zaeem-logistics-hub",
  "private": true,
  "description": "Repository root. Forwards the common commands to the Angular app in zaeem-distribute-ui/.",
  "scripts": {
    "start": "npm --prefix zaeem-distribute-ui start",
